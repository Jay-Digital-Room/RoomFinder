# 복사해서 .env 로 저장 후 값을 채우세요:  cp .env.example .env

PORT=3000

# ---------- 데이터 ----------
# live: 실제 사이트 크롤링 / mock: 가상 데이터(개발·테스트용)
DATA_MODE=live
# 수집 지역·거래유형·방 종류·가격·플랫폼은 npm start 할 때 터미널에서 묻고,
# 웹 화면의 "수집 조건" 에서도 바꿀 수 있습니다. (data/conditions.json 에 저장)
# 주기적 재수집 간격(분). 0이면 시작 시 1회만
CRAWL_INTERVAL_MIN=60
# 소스별 요청 사이 최소 간격(ms) — 너무 낮추면 차단됩니다
CRAWL_DELAY_MS=1500
# 한 번 수집 시 소스별 최대 페이지 수
CRAWL_MAX_PAGES=3

# ---------- 지도 ----------
# kakao | naver | leaflet  (생략 시 키가 있는 쪽 자동 선택)
MAP_PROVIDER=kakao
# 카카오 디벨로퍼스(https://developers.kakao.com) > 내 애플리케이션 > 앱 키 > JavaScript 키
#   + 플랫폼 > Web 에 http://localhost:3000 등록
KAKAO_MAP_KEY=
# 네이버 클라우드 플랫폼(https://console.ncloud.com) > Maps > Application 등록 > Client ID
#   + Web 서비스 URL 에 http://localhost:3000 등록
NAVER_MAP_KEY_ID=
